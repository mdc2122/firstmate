#!/usr/bin/env python3
# Fake gh-axi: serves GitHub API fixture JSON, applies --jq with real jq, prints TOON-ish `body: "..."`.
import json, os, subprocess, sys
a = sys.argv[1:]; path = a[1]; jq = a[a.index("--jq") + 1]
open(os.environ["GHFAKE_LOG"], "a").write(path + "\n")
F = json.load(open(os.environ["GHFAKE_FIXTURES"]))
base = path.split("?")[0]; qs = path.split("?")[1] if "?" in path else ""
data = F.get(base)
if data is None: print("error: 404 Not Found"); sys.exit(1)
if base.endswith("/pulls") and "page=1" not in qs.split("&"): data = []
if base.endswith("/runs") and "page=1" not in qs.split("&"): data = dict(workflow_runs=[])
out = subprocess.run(["jq", "-r", jq], input=json.dumps(data), capture_output=True, text=True, check=True).stdout.strip()
print(f'status: 200\nbody: "{out}"')
